/**
 * 物时 · 全局样式
 * 设计语言：新极简 + 舒缓式（低饱和、大留白、柔圆角、无强阴影）
 */

page {
  /* 底色与容器：暖米色背景，提升与白色卡片的对比，减少"灰白发飘" */
  --bg: #f7f6f3;
  --surface: #ffffff;
  --surface-soft: #fbfaf7;
  --line: #efeee9;

  /* 文字：整体加深，提升可读性（适老） */
  --text: #1f2420;
  --text-2: #535b55;
  --text-3: #798178;

  /* 主色：鼠尾草绿（加深以保证白字对比度） */
  --primary: #3f8a6b;
  --primary-soft: #dcefe4;
  --primary-deep: #3d6757;

  /* 状态色：同步加深 */
  --warn: #d18c2a;
  --warn-soft: #fbebd3;
  --danger: #d4553c;
  --danger-soft: #fce0d8;
  --muted: #7c7c76;
  --muted-soft: #f0efec;

  /* 圆角 */
  --r-lg: 32rpx;
  --r-md: 24rpx;
  --r-sm: 16rpx;
  --r-pill: 999rpx;

  /* 阴影：极轻，避免视觉压迫 */
  --shadow: 0 6rpx 30rpx rgba(43, 47, 44, 0.08);
  --shadow-sm: 0 2rpx 12rpx rgba(43, 47, 44, 0.06);

  /* 字号：整体放大一档（适老） */
  --fs-xl: 48rpx;
  --fs-lg: 34rpx;
  --fs-md: 30rpx;
  --fs-sm: 26rpx;
  --fs-xs: 24rpx;

  /* 间距 */
  --gap: 28rpx;

  background-color: var(--bg);
  color: var(--text);
  font-size: var(--fs-md);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

/* ---------- 页面容器 ---------- */
.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 32rpx;
  box-shadow: var(--shadow);
}

.card-soft {
  background: var(--surface-soft);
  border-radius: var(--r-lg);
  padding: 32rpx;
}

/* ---------- 文本 ---------- */
.t-title {
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.5rpx;
}

.t-sub {
  font-size: var(--fs-sm);
  color: var(--text-2);
}

.t-tip {
  font-size: var(--fs-xs);
  color: var(--text-3);
}

.t-num {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

/* ---------- 布局 ---------- */
.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
}

.grid-2 > view {
  width: 50%;
}

/* ---------- 标签 ---------- */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-xs);
  background: var(--muted-soft);
  color: var(--text-2);
}

.chip-primary {
  background: var(--primary-soft);
  color: var(--primary);
}

.chip-warn {
  background: var(--warn-soft);
  color: var(--warn);
}

.chip-danger {
  background: var(--danger-soft);
  color: var(--danger);
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx; /* 触控区加大，适老 */
  border-radius: var(--r-pill);
  font-size: 30rpx;
  background: var(--primary);
  color: #ffffff;
  transition: opacity 0.2s, transform 0.15s;
}

.btn::after {
  border: none;
}

.btn-hover {
  opacity: 0.86;
  transform: scale(0.985);
}

.btn-ghost {
  background: var(--surface-soft);
  color: var(--text);
  border: 2rpx solid var(--line);
}

.btn-danger-text {
  background: transparent;
  color: var(--danger);
}

.btn-sm {
  height: 76rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  border-radius: var(--r-pill);
}

/* ---------- 分割线 ---------- */
.divider {
  height: 2rpx;
  background: var(--line);
  margin: 24rpx 0;
}

/* ---------- 安全区 ---------- */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ---------- 悬浮按钮 ---------- */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: 0 10rpx 30rpx rgba(76, 124, 104, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.fab-plus {
  color: #fff;
  font-size: 60rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

/* ---------- 隐藏滚动条 ---------- */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}
