<view class="page">

  <!-- 统计 -->
  <view class="card stat-card">
    <view class="us-row">
      <view class="us-cell">
        <text class="us-num">{{todayCount}}</text>
        <text class="us-name">今日记录</text>
      </view>
      <view class="us-cell">
        <text class="us-num">{{totalCount}}</text>
        <text class="us-name">累计记录</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{empty}}" class="card empty-card">
    <empty-state
      emoji="🗓️"
      text="还没有事件记录"
      subText="在事件页点卡片右侧的 ↺ 或 −，每记一次就留一笔"
    />
  </view>

  <!-- 记录分组 -->
  <view wx:for="{{groups}}" wx:key="date" class="sec">
    <view class="sec-hd">
      <text class="t-title">{{item.title}}</text>
      <text class="sec-more">{{item.items.length}} 条</text>
    </view>

    <view class="card ul-card">
      <view
        class="ul-row"
        wx:for="{{item.items}}"
        wx:for-item="log"
        wx:key="logId"
        data-id="{{log.itemId}}"
        data-logid="{{log.logId}}"
        data-archived="{{log.archived ? 1 : 0}}"
        data-deleted="{{log.deleted ? 1 : 0}}"
        bindtap="goDetail"
        bindlongpress="onDeleteLog"
        hover-class="ul-hover"
        hover-stay-time="60"
      >
        <text class="ul-icon">{{log.icon}}</text>
        <view class="ul-main">
          <text class="ul-name">{{log.name}}</text>
          <text class="ul-sub">{{log.timeText}}{{log.tag}}</text>
        </view>
        <text class="ul-gap">{{log.gapText}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!empty}}" class="foot-tip">
    <text>最多保留最近 {{limit}} 条记录 · 长按某条可单独删除</text>
  </view>

  <view wx:if="{{!empty}}" class="foot-act">
    <text class="foot-act-btn" bindtap="onClearLogs" hover-class="foot-act-hover">清空全部事件记录</text>
  </view>

</view>
