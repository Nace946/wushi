<view class="page" wx:if="{{form}}">

  <!-- ① 先选记录类型：物品 / 事件（v3.0 起常显，不再只在正计时下出现） -->
  <view class="block">
    <text class="block-title">记录什么</text>
    <view class="modes">
      <view
        class="mode {{kind === 'item' ? 'mode-on' : ''}}"
        data-kind="item"
        bindtap="onKind"
      >
        <text class="mode-emoji">📦</text>
        <view class="mode-text">
          <text class="mode-name">物品</text>
          <text class="mode-desc">食品、日用品…</text>
        </view>
      </view>
      <view
        class="mode {{kind === 'event' ? 'mode-on' : ''}}"
        data-kind="event"
        bindtap="onKind"
      >
        <text class="mode-emoji">🗓️</text>
        <view class="mode-text">
          <text class="mode-name">事件</text>
          <text class="mode-desc">健身、聚会…</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ② 再选计时方式：倒计时 / 正计时（两种记录类型都适用） -->
  <view class="block">
    <text class="block-title">计时方式</text>
    <view class="modes">
      <view
        class="mode {{form.mode === 'countdown' ? 'mode-on' : ''}}"
        data-mode="countdown"
        bindtap="onMode"
      >
        <text class="mode-emoji">⏳</text>
        <view class="mode-text">
          <text class="mode-name">倒计时</text>
          <text class="mode-desc">离到期还有多久</text>
        </view>
      </view>
      <view
        class="mode {{form.mode === 'countup' ? 'mode-on' : ''}}"
        data-mode="countup"
        bindtap="onMode"
      >
        <text class="mode-emoji">🌱</text>
        <view class="mode-text">
          <text class="mode-name">正计时</text>
          <text class="mode-desc">距上次过了多久</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 预设模板（按当前类型与计时方式匹配，无匹配时整块隐藏） -->
  <view class="block" wx:if="{{presets.length}}">
    <text class="block-title">{{ktPresetTitle}}</text>
    <scroll-view scroll-x class="preset-scroll" show-scrollbar="{{false}}">
      <view class="preset-inner">
        <view
          class="preset"
          wx:for="{{presets}}"
          wx:key="name"
          data-index="{{index}}"
          bindtap="onPreset"
          hover-class="preset-hover"
          hover-stay-time="60"
        >
          <text class="preset-emoji">{{item.icon}}</text>
          <text class="preset-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 名称 + 图标（仅「物品 + 倒计时」附数量与存放位置） -->
  <view class="card name-card">
    <view class="nb-row">
      <!-- 图标：点击弹出选择面板 -->
      <view
        class="nb-icon-btn"
        bindtap="openIconPicker"
        hover-class="nb-icon-hover"
        hover-stay-time="60"
      >
        <text class="nb-emoji">{{form.icon}}</text>
        <view class="nb-caret">▾</view>
      </view>

      <!-- 名称：加大突出 -->
      <view class="nb-main">
        <text class="nb-label">{{ktNameLabel}}</text>
        <input always-embed="{{true}}"
          class="nb-input"
          value="{{form.name}}"
          bindinput="onNameInput"
          placeholder="{{ktNamePlaceholder}}"
          placeholder-class="nb-ph"
          maxlength="20"
        />
      </view>
    </view>

    <!-- 数量与存放位置：只对「物品 + 倒计时」有意义（事件与正计时都隐藏） -->
    <block wx:if="{{!isCountUp && !isEvent}}">
      <view class="field">
        <text class="flabel">数量</text>
        <view class="qty-row">
          <input always-embed="{{true}}"
            class="finput qty-input"
            type="number"
            value="{{form.quantity}}"
            data-field="quantity"
            bindinput="onInput"
            placeholder="1"
            placeholder-class="fph"
            maxlength="3"
          />
          <input always-embed="{{true}}"
            class="finput unit-input"
            value="{{form.unit}}"
            data-field="unit"
            bindinput="onInput"
            placeholder="份"
            placeholder-class="fph"
            maxlength="4"
          />
        </view>
      </view>

      <view class="field">
        <text class="flabel">存放位置</text>
        <input always-embed="{{true}}"
          class="finput"
          value="{{form.location}}"
          data-field="location"
          bindinput="onInput"
          placeholder="例如：冰箱冷藏"
          placeholder-class="fph"
          maxlength="16"
        />
      </view>
    </block>
  </view>

  <!-- 分类（随物品 / 事件变化） -->
  <view class="card">
    <view class="field field-col">
      <text class="flabel">分类</text>
      <view class="cat-chips">
        <view
          class="cchip {{form.category === item.key ? 'cchip-on' : ''}}"
          wx:for="{{categories}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onCategory"
        >{{item.icon}} {{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- ============ 倒计时：到期信息（文案随物品 / 事件变化） ============ -->
  <view class="block" wx:if="{{form.mode === 'countdown'}}">
    <text class="block-title">{{ktExpireTitle}}</text>
    <view class="card">
      <view class="switch-row">
        <view>
          <text class="flabel">{{ktCdManual}}</text>
          <text class="fhint">{{ktCdManualHint}}</text>
        </view>
        <switch
          checked="{{form.expireManual}}"
          bindchange="onExpireManual"
          color="#0A7F4E"
        />
      </view>

      <view wx:if="{{form.expireManual}}">
        <view class="field">
          <text class="flabel">{{ktCdExpire}}</text>
          <picker
            mode="date"
            value="{{form.expireDate}}"
            start="2000-01-01"
            end="2040-12-31"
            data-field="expireDate"
            bindchange="onDate"
          >
            <view class="fvalue">{{form.expireDate || '请选择'}}</view>
          </picker>
        </view>
      </view>

      <view wx:else>
        <view class="field">
          <text class="flabel">{{ktCdStart}}</text>
          <picker
            mode="date"
            value="{{form.produceDate}}"
            start="2000-01-01"
            end="2040-12-31"
            data-field="produceDate"
            bindchange="onDate"
          >
            <view class="fvalue">{{form.produceDate || '请选择'}}</view>
          </picker>
        </view>

        <view class="field field-col">
          <text class="flabel">{{ktCdSpan}}</text>
          <view class="life-row">
            <input always-embed="{{true}}"
              class="finput life-input"
              type="digit"
              value="{{form.shelfLife}}"
              data-field="shelfLife"
              bindinput="onInput"
              placeholder="0"
              placeholder-class="fph"
              maxlength="4"
            />
            <view class="seg">
              <view
                class="seg-item {{form.shelfLifeUnit === item.key ? 'seg-on' : ''}}"
                wx:for="{{units}}"
                wx:key="key"
                data-key="{{item.key}}"
                bindtap="onUnitTap"
              >{{item.name}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 到期日预览：只在你「没直接填到期日」时才有意义（用于展示系统算出来的结果）。
           直接填写到期日时，上方就是同一个日期，再预览一次只是重复。 -->
      <view wx:if="{{expirePreview && !form.expireManual}}" class="preview">
        <text class="preview-label">{{ktCdExpire}}</text>
        <text class="preview-value">{{expirePreview}}</text>
      </view>

      <!-- 到期时刻口径：到期日当天 23:59 结束，剩余不足一天时列表改显示小时 / 分钟 -->
      <view class="cd-hint">
        <text>到期时间为当天 23:59，不足一天时显示还剩几小时</text>
      </view>

      <!-- 事件 × 倒计时：完成后是否自动进入下一轮（物品用不到，用完即换新） -->
      <view wx:if="{{isEvent && !form.expireManual}}" class="field field-switch">
        <view class="sw-main">
          <text class="flabel">{{ktCyclicLabel}}</text>
          <text class="fhint">{{ktCyclicHint}}</text>
        </view>
        <switch
          checked="{{cyclicEnabled}}"
          bindchange="onCyclicToggle"
          color="#0A7F4E"
        />
      </view>

      <!-- 直接填写到期日：没有周期长度可推演，不做循环，因此不显示开关，只给一句说明 -->
      <view wx:if="{{isEvent && form.expireManual}}" class="open-line">
        <text class="open-emoji">🕊️</text>
        <text class="open-text">{{ktCyclicManual}}</text>
      </view>

      <!-- 不循环：完成后只留一条记录，这条计时会自动收起 -->
      <view wx:if="{{isEvent && !form.expireManual && !cyclicEnabled}}" class="open-line">
        <text class="open-emoji">🕊️</text>
        <text class="open-text">{{ktCyclicOff}}</text>
      </view>
    </view>
  </view>

  <!-- ============ 正计时：时间记录 / 循环间隔 ============ -->
  <view class="block" wx:else>
    <text class="block-title">{{ktPeriodWord}}</text>
    <view class="card">
      <!-- 语义引导 -->
      <view class="tip-line">
        <text class="tip-emoji">🌿</text>
        <text class="tip-text">{{ktTip}}</text>
      </view>

      <view class="field">
        <text class="flabel">{{ktLastLabel}}</text>
        <picker
          mode="date"
          value="{{form.lastDate}}"
          start="2000-01-01"
          end="2040-12-31"
          data-field="lastDate"
          bindchange="onDate"
        >
          <view class="fvalue">{{form.lastDate || '请选择'}}</view>
        </picker>
      </view>

      <!-- 起点精确时刻：所有正计时通用（不足一天时按小时/分钟统计已过去多久）。
           点时间可手动指定，也可以一键取当前时间；两者都不用时按「今天→此刻 / 过去→当天 0 点」兜底 -->
      <view class="field field-col">
        <text class="flabel">精确时刻</text>
        <view class="at-row">
          <picker
            class="at-picker"
            mode="time"
            value="{{atTime}}"
            bindchange="onPickAt"
          >
            <view class="at-value {{atEmpty ? 'at-empty' : ''}}">{{atText}}</view>
          </picker>
          <view class="at-btn" bindtap="onPickNow" hover-class="at-btn-hover" hover-stay-time="60">
            ↻ 取当前时间
          </view>
        </view>
        <text class="fhint">点上面的时间可手动指定{{isEvent ? ' · 事件记录里的这一条会一起改' : ''}}</text>
      </view>

      <!-- 事件：循环间隔为可选项，关闭即「只记录时间」 -->
      <view wx:if="{{isEvent}}" class="field field-switch">
        <view class="sw-main">
          <text class="flabel">{{ktCycleSwitch}}</text>
          <text class="fhint">{{ktCycleSwitchHint}}</text>
        </view>
        <switch
          checked="{{cycleEnabled}}"
          bindchange="onCycleToggle"
          color="#0A7F4E"
        />
      </view>

      <!-- 循环间隔（事件关闭时整块隐藏） -->
      <block wx:if="{{!isEvent || cycleEnabled}}">
        <view class="field field-col">
          <text class="flabel">{{ktCycleLabel}}</text>
          <input always-embed="{{true}}"
            class="finput"
            type="number"
            value="{{form.cycleDays}}"
            data-field="cycleDays"
            bindinput="onInput"
            placeholder="例如：14"
            placeholder-class="fph"
            maxlength="4"
          />
          <view class="quick-row">
            <view
              class="quick {{form.cycleDays == item ? 'quick-on' : ''}}"
              wx:for="{{cycleOptions}}"
              wx:key="*this"
              data-days="{{item}}"
              bindtap="onCycleQuick"
            >{{item}}天</view>
          </view>
        </view>

        <view wx:if="{{cyclePreview}}" class="preview">
          <text class="preview-label">{{ktNextLabel}}</text>
          <text class="preview-value">{{cyclePreview}}</text>
        </view>
      </block>

      <!-- 纯记录：不设循环间隔的说明 -->
      <view wx:else class="open-line">
        <text class="open-emoji">🕊️</text>
        <text class="open-text">{{ktCycleOff}}</text>
      </view>

      <!-- 详细计时：超过一天后显示 年/月/日/时 细分（起点时刻不受它影响） -->
      <view class="field field-switch">
        <view class="sw-main">
          <text class="flabel">详细计时显示</text>
          <text class="fhint">开启后可以显示具体间隔时间（精确到小时）</text>
        </view>
        <switch
          checked="{{form.detailTiming}}"
          bindchange="onDetailTiming"
          color="#0A7F4E"
        />
      </view>
    </view>
  </view>

  <!-- 其他信息 -->
  <view class="block">
    <text class="block-title">{{isCountUp ? '提醒与备注' : '其他信息'}}</text>
    <view class="card">
      <!-- 置顶到首页：最多 5 条，名额满时切换会给出提示 -->
      <view class="field field-switch">
        <view class="sw-main">
          <text class="flabel">{{pinText.label}}</text>
          <text class="fhint">{{form.pinned ? pinText.hintOn : pinText.hint}}（{{pinUsed}}/{{pinLimit}}）</text>
        </view>
        <switch
          checked="{{pinEnabled}}"
          bindchange="onPinToggle"
          color="#0A7F4E"
        />
      </view>

      <!-- 提前提醒：倒计时（物品/事件）都有；正计时里只有「有循环间隔」的才有 -->
      <view wx:if="{{!isCountUp || !isEvent || cycleEnabled}}" class="field field-col">
        <text class="flabel">提前提醒</text>
        <view class="quick-row">
          <view
            class="quick {{form.remindDays == item.v ? 'quick-on' : ''}}"
            wx:for="{{remindOptions}}"
            wx:key="v"
            data-days="{{item.v}}"
            bindtap="onRemindQuick"
          >{{item.t}}</view>
        </view>
        <text class="fhint">选「不提醒」则不提前预警，只在临近时由颜色变化提示</text>
      </view>

      <view class="field field-col">
        <text class="flabel">备注</text>
        <textarea disable-default-padding="{{true}}"
          class="ftextarea"
          value="{{form.remark}}"
          bindinput="onRemarkInput"
          placeholder="补充说明（可选）"
          placeholder-class="fph"
          maxlength="100"
          auto-height
        />
      </view>
    </view>
  </view>

  <!-- 提交 -->
  <view class="submit-area">
    <view class="btn btn-primary" bindtap="onSave" hover-class="btn-hover" hover-stay-time="80">
      {{isEdit ? '保存修改' : ktSubmitNew}}
    </view>
    <view wx:if="{{isEdit}}" class="btn btn-danger-text" bindtap="onDelete" hover-class="btn-hover" hover-stay-time="80">
      删除这条记录
    </view>
  </view>

  <!-- 图标选择面板（仿微信选表情） -->
  <view wx:if="{{showIconPicker}}" class="ip-mask" bindtap="closeIconPicker">
    <view class="ip-panel" catchtap="noop">
      <view class="ip-head">
        <text class="ip-title">选择图标</text>
        <text class="ip-close" catchtap="closeIconPicker">✕</text>
      </view>

      <scroll-view scroll-x class="ip-tabs" show-scrollbar="{{false}}">
        <view class="ip-tabs-inner">
          <view
            class="ip-tab {{iconGroup === item.key ? 'ip-tab-on' : ''}}"
            wx:for="{{emojiGroups}}"
            wx:key="key"
            data-key="{{item.key}}"
            catchtap="onIconGroup"
          >{{item.name}}</view>
        </view>
      </scroll-view>

      <scroll-view scroll-y class="ip-body">
        <view class="ip-grid">
          <view
            class="ip-cell {{form.icon === item ? 'ip-cell-on' : ''}}"
            wx:for="{{currentIcons}}"
            wx:key="*this"
            data-emoji="{{item}}"
            catchtap="pickIcon"
          >{{item}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

</view>
