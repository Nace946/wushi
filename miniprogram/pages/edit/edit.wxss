.block {
  margin-top: 36rpx;
}

.block-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  padding: 0 8rpx 18rpx;
}

/* ---------- 预设 ---------- */
.preset-scroll {
  width: 100%;
  white-space: nowrap;
}

.preset-inner {
  display: inline-flex;
}

.preset {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  padding: 20rpx 0;
  margin-right: 14rpx;
  background: var(--surface);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-sm);
}

.preset-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.preset-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.preset-hover {
  opacity: 0.8;
}

/* ---------- 表单 ---------- */
.card {
  margin-top: 24rpx;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.field:last-child {
  border-bottom: none;
}

.field-col {
  flex-direction: column;
  align-items: stretch;
}

.flabel {
  font-size: 29rpx;
  color: var(--text);
  flex-shrink: 0;
}

.fhint {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.finput {
  flex: 1;
  min-width: 0;
  /* 显式 rpx 高度 + 行高：原生 input 的高度不随 rpx 走，只写 padding 在平板上会塌成一条窄缝 */
  height: 64rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  text-align: right;
  font-size: 29rpx;
  color: var(--text);
}

.fph {
  color: var(--text-3);
}

.fvalue {
  font-size: 29rpx;
  color: var(--primary);
  padding: 4rpx 0;
}

/* 未选日期（事件正计时的默认态）：灰字占位，不假装已经填过 */
.fvalue-empty {
  color: var(--text-3, #798178);
}

.ftextarea {
  width: 100%;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--text);
  min-height: 120rpx;
  line-height: 1.6;
}

/* ---------- 模式选择 ---------- */
.modes {
  display: flex;
}

.mode {
  flex: 1;
  min-width: 0;
  background: var(--surface);
  border-radius: var(--r-md);
  padding: 24rpx 20rpx;
  margin-right: 16rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  /* 图标与文字同排：图标在左，名称与说明在右 */
  flex-direction: row;
  align-items: center;
  border: 2rpx solid transparent;
}

.mode:last-child {
  margin-right: 0;
}

.mode-on {
  border-color: var(--primary);
  background: var(--primary-soft);
}

.mode-emoji {
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: 44rpx;
  line-height: 1;
}

/* 图标右侧的文字块：名称在上、说明在下 */
.mode-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.mode-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.mode-desc {
  margin-top: 2rpx;
  font-size: 22rpx;
  line-height: 1.3;
  color: var(--text-3);
}

/* ---------- 分段控件 ---------- */
.seg {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  height: 68rpx;
  margin-left: 16rpx;
  padding: 4rpx;
  background: var(--surface-soft);
  border-radius: var(--r-pill);
}

.seg-item {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 22rpx;
  white-space: nowrap;
  border-radius: var(--r-pill);
  font-size: 26rpx;
  color: var(--text-2);
}

.seg-on {
  background: #ffffff;
  color: var(--primary);
  box-shadow: var(--shadow-sm);
}

/* 保质期 / 持续天数：标签在左，数字框与单位选择紧跟在右侧同一行（v3.21）
   不再各占一行——那样这一栏和上面「生产日期」等字段的排法对不上，看着也浪费高度 */
.life-row {
  display: flex;
  align-items: center;
  /* 靠右收拢，数字框吃掉剩余空隙，单位永远贴在同一行的末端 */
  justify-content: flex-end;
  flex: 1;
  min-width: 0;
  flex-wrap: nowrap;
  margin-left: 20rpx;
}

.life-input {
  /* 不再定宽：右侧剩余多少就用多少，最小可收缩到 0，保证单位不被挤到下一行 */
  flex: 1;
  min-width: 0;
  height: 68rpx;
  min-height: 68rpx;
  line-height: 68rpx;
  box-sizing: border-box;
  /* 数字在框内居中（v3.21），不再贴着单位右对齐 */
  text-align: center;
  font-size: 29rpx;
  background: var(--surface-soft);
  border-radius: var(--r-sm);
  padding: 0 20rpx;
}

/* 循环间隔：标签在左、灰底数字框在右，同一行（v3.21，与「保质期 / 持续天数」保持同一套排法） */
.cycle-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.cycle-box {
  /* 定宽小方框（flex:1 会铺满整行，用户嫌长），只够放 4 位数 + 天 */
  flex: none;
  width: 220rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 20rpx;
  background: var(--surface-soft);
  border-radius: var(--r-sm);
}

.cycle-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  min-height: 68rpx;
  line-height: 68rpx;
  padding: 0;
  background: transparent;
  /* 与倒计时的数字框同字号、同居中方式（v3.21） */
  text-align: center;
  font-size: 29rpx;
  color: var(--text);
}

.cycle-unit {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 27rpx;
  color: var(--text-3);
}

/* ---------- 快捷选择 ---------- */.quick-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.quick {
  padding: 10rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: var(--r-pill);
  font-size: 25rpx;
  color: var(--text-2);
  background: var(--surface-soft);
  border: 2rpx solid var(--line);
}

.quick-on {
  background: var(--primary-soft);
  border-color: var(--primary-soft);
  color: var(--primary);
}

/* ---------- 名称 + 图标 ---------- */
.name-card {
  padding: 24rpx 24rpx 26rpx;
}

.nb-row {
  display: flex;
  align-items: center;
}

.nb-icon-btn {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  background: var(--surface-soft);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.nb-icon-hover {
  opacity: 0.82;
  transform: scale(0.97);
}

.nb-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.nb-caret {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 42rpx;
  text-align: center;
}

.nb-main {
  flex: 1;
  min-width: 0;
}

.nb-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 6rpx;
}

.nb-input {
  width: 100%;
  /* 名称是主角：字号最大，必须给它足够的高度，否则平板上原生层会把字压扁 */
  height: 84rpx;
  min-height: 84rpx;
  line-height: 84rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
  padding: 0;
  border-bottom: 2rpx solid var(--line);
}

.nb-ph {
  color: var(--text-3);
  font-weight: 400;
}

/* ---------- 图标选择面板 ---------- */
.ip-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 36, 32, 0.45);
  z-index: 300;
  display: flex;
  align-items: flex-end;
}

.ip-panel {
  width: 100%;
  background: var(--surface);
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  max-height: 76vh;
  display: flex;
  flex-direction: column;
}

.ip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 18rpx;
}

.ip-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.ip-close {
  font-size: 30rpx;
  color: var(--text-3);
  padding: 0 12rpx;
}

.ip-tabs {
  width: 100%;
  white-space: nowrap;
}

.ip-tabs-inner {
  display: inline-flex;
}

.ip-tab {
  padding: 10rpx 26rpx;
  margin-right: 12rpx;
  border-radius: var(--r-pill);
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--surface-soft);
}

.ip-tab-on {
  background: var(--primary);
  color: #ffffff;
}

.ip-body {
  flex: 1;
  margin-top: 20rpx;
  max-height: 52vh;
}

.ip-grid {
  display: flex;
  flex-wrap: wrap;
}

.ip-cell {
  width: 16.66%;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
}

.ip-cell-on {
  background: var(--primary-soft);
  border-color: var(--primary);
}

.cat-chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.cchip {
  padding: 12rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: var(--r-pill);
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--surface-soft);
  border: 2rpx solid var(--line);
}

.cchip-on {
  background: var(--primary);
  border-color: var(--primary);
  color: #ffffff;
}

/* ---------- 数量 ---------- */
.qty-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  /* 占满标签右侧的剩余空间，两个小框随屏幕一起变宽，不会停在固有宽度上 */
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.qty-input {
  flex: 1;
  min-width: 0;
  /* 高度全部用 rpx 显式定死：原生 input 在平板上不认 padding，只写 padding 会压成一条缝 */
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: var(--surface-soft);
  border-radius: var(--r-sm);
  padding: 0 20rpx;
}

.unit-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: var(--surface-soft);
  border-radius: var(--r-sm);
  padding: 0 20rpx;
}

/* ---------- 预览与提交 ---------- */
.preview {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--r-md);
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.preview-label {
  font-size: 26rpx;
  color: var(--primary);
}

.preview-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
}

/* 到期时刻口径说明：小字，跟在预览框下面 */
.cd-hint {
  margin-top: 12rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}

/* ---------- 正计时引导条 ---------- */
.tip-line {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 24rpx;
  margin-bottom: 8rpx;
  background: var(--primary-soft);
  border-radius: var(--r-md);
}

.tip-emoji {
  font-size: 34rpx;
  line-height: 1.4;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--primary);
  line-height: 1.6;
}

/* ---------- 精确时刻（详细计时起点） ---------- */
.at-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

/* 时间选择器吃掉整行剩余宽度（flex 项需要 min-width:0 才不会被文字撑破） */
.at-picker {
  flex: 1;
  min-width: 0;
}

/* 主色 = 可点改；与上方「上次发生日期」的 .fvalue 保持同一套点击暗示 */
.at-value {
  font-size: 30rpx;
  color: var(--primary, #0a7f4e);
  font-variant-numeric: tabular-nums;
}

.at-empty {
  font-size: 26rpx;
  color: var(--text-3, #798178);
}

.at-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 14rpx 26rpx;
  border-radius: var(--r-pill, 999rpx);
  background: var(--primary-soft, #dcefe4);
  color: var(--primary, #0a7f4e);
  font-size: 26rpx;
  line-height: 1;
}

.at-btn-hover {
  opacity: 0.72;
}

/* ---------- 纯记录（未设循环间隔）提示 ---------- */
.open-line {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 24rpx;
  margin-top: 8rpx;
  background: var(--surface-soft, #fbfaf7);
  border-radius: var(--r-md, 24rpx);
}

.open-emoji {
  font-size: 34rpx;
  line-height: 1.3;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.open-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-2, #535b55);
  line-height: 1.6;
}

/* ---------- 开关行（详细计时 / 置顶到首页） ---------- */
.field-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sw-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.fhint {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.submit-area {
  margin-top: 48rpx;
}

/* ---------- 手机日历联动（提前提醒下方） ---------- */
.cal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--primary-soft);
  border-radius: 20rpx;
}

.cal-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.cal-label {
  display: block;
  font-size: 27rpx;
  color: var(--primary-deep);
}

.cal-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.submit-area .btn {
  margin-bottom: 20rpx;
}
