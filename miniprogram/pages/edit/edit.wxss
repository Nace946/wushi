.block {
  margin-top: 36rpx;
}

.block-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  padding: 0 8rpx 18rpx;
}

/* ---------- 预设 ---------- */
.preset-scroll {
  width: 100%;
  white-space: nowrap;
}

.preset-inner {
  display: inline-flex;
}

.preset {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  padding: 20rpx 0;
  margin-right: 14rpx;
  background: var(--surface);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-sm);
}

.preset-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.preset-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.preset-hover {
  opacity: 0.8;
}

/* ---------- 表单 ---------- */
.card {
  margin-top: 24rpx;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.field:last-child {
  border-bottom: none;
}

.field-col {
  flex-direction: column;
  align-items: stretch;
}

.flabel {
  font-size: 29rpx;
  color: var(--text);
  flex-shrink: 0;
}

.fhint {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.finput {
  flex: 1;
  text-align: right;
  font-size: 29rpx;
  color: var(--text);
}

.fph {
  color: var(--text-3);
}

.fvalue {
  font-size: 29rpx;
  color: var(--primary);
  padding: 4rpx 0;
}

.ftextarea {
  width: 100%;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--text);
  min-height: 120rpx;
  line-height: 1.6;
}

/* ---------- 模式选择 ---------- */
.modes {
  display: flex;
}

.mode {
  flex: 1;
  background: var(--surface);
  border-radius: var(--r-md);
  padding: 28rpx 20rpx;
  margin-right: 16rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  border: 2rpx solid transparent;
}

.mode:last-child {
  margin-right: 0;
}

.mode-on {
  border-color: var(--primary);
  background: var(--primary-soft);
}

.mode-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.mode-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.mode-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ---------- 分段控件 ---------- */
.seg {
  display: flex;
  background: var(--surface-soft);
  border-radius: var(--r-pill);
  padding: 4rpx;
}

.seg-item {
  padding: 10rpx 24rpx;
  border-radius: var(--r-pill);
  font-size: 26rpx;
  color: var(--text-2);
}

.seg-on {
  background: #ffffff;
  color: var(--primary);
  box-shadow: var(--shadow-sm);
}

.life-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.life-input {
  flex: none;
  width: 200rpx;
  text-align: left;
  background: var(--surface-soft);
  border-radius: var(--r-sm);
  padding: 14rpx 20rpx;
}

/* ---------- 快捷选择 ---------- */
.quick-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.quick {
  padding: 10rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: var(--r-pill);
  font-size: 25rpx;
  color: var(--text-2);
  background: var(--surface-soft);
  border: 2rpx solid var(--line);
}

.quick-on {
  background: var(--primary-soft);
  border-color: var(--primary-soft);
  color: var(--primary);
}

/* ---------- 名称 + 图标 ---------- */
.name-card {
  padding: 24rpx 24rpx 26rpx;
}

.nb-row {
  display: flex;
  align-items: center;
}

.nb-icon-btn {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  background: var(--surface-soft);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.nb-icon-hover {
  opacity: 0.82;
  transform: scale(0.97);
}

.nb-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.nb-caret {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 42rpx;
  text-align: center;
}

.nb-main {
  flex: 1;
  min-width: 0;
}

.nb-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 6rpx;
}

.nb-input {
  width: 100%;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
  padding: 1rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.nb-ph {
  color: var(--text-3);
  font-weight: 400;
}

/* ---------- 图标选择面板 ---------- */
.ip-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 36, 32, 0.45);
  z-index: 300;
  display: flex;
  align-items: flex-end;
}

.ip-panel {
  width: 100%;
  background: var(--surface);
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  max-height: 76vh;
  display: flex;
  flex-direction: column;
}

.ip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 18rpx;
}

.ip-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.ip-close {
  font-size: 30rpx;
  color: var(--text-3);
  padding: 0 12rpx;
}

.ip-tabs {
  width: 100%;
  white-space: nowrap;
}

.ip-tabs-inner {
  display: inline-flex;
}

.ip-tab {
  padding: 10rpx 26rpx;
  margin-right: 12rpx;
  border-radius: var(--r-pill);
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--surface-soft);
}

.ip-tab-on {
  background: var(--primary);
  color: #ffffff;
}

.ip-body {
  flex: 1;
  margin-top: 20rpx;
  max-height: 52vh;
}

.ip-grid {
  display: flex;
  flex-wrap: wrap;
}

.ip-cell {
  width: 16.66%;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
}

.ip-cell-on {
  background: var(--primary-soft);
  border-color: var(--primary);
}

.cat-chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.cchip {
  padding: 12rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: var(--r-pill);
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--surface-soft);
  border: 2rpx solid var(--line);
}

.cchip-on {
  background: var(--primary);
  border-color: var(--primary);
  color: #ffffff;
}

/* ---------- 数量 ---------- */
.qty-row {
  display: flex;
  align-items: center;
}

.qty-input {
  width: 140rpx;
  text-align: center;
  background: var(--surface-soft);
  border-radius: var(--r-sm);
  padding: 12rpx 16rpx;
}

.unit-input {
  width: 120rpx;
  margin-left: 12rpx;
  text-align: center;
  background: var(--surface-soft);
  border-radius: var(--r-sm);
  padding: 12rpx 16rpx;
}

/* ---------- 预览与提交 ---------- */
.preview {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--r-md);
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.preview-label {
  font-size: 26rpx;
  color: var(--primary);
}

.preview-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}

/* ---------- 正计时引导条 ---------- */
.tip-line {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 24rpx;
  margin-bottom: 8rpx;
  background: var(--primary-soft);
  border-radius: var(--r-md);
}

.tip-emoji {
  font-size: 34rpx;
  line-height: 1.4;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--primary);
  line-height: 1.6;
}

/* ---------- 纯记录（未设循环间隔）提示 ---------- */
.open-line {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 24rpx;
  margin-top: 8rpx;
  background: var(--surface-soft, #fbfaf7);
  border-radius: var(--r-md, 24rpx);
}

.open-emoji {
  font-size: 34rpx;
  line-height: 1.3;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.open-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-2, #535b55);
  line-height: 1.6;
}

/* ---------- 开关行（详细计时） ---------- */
.field-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sw-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.fhint {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.submit-area {
  margin-top: 48rpx;
}

.submit-area .btn {
  margin-bottom: 20rpx;
}
