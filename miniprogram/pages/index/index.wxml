<view class="page">

  <!-- 顶部问候 -->
  <view class="hd">
    <view class="hd-left">
      <text class="hd-hello">{{greeting}}</text>
      <text class="hd-slogan">{{slogan}}</text>
    </view>
    <view class="hd-btn" bindtap="goGuide">
      <text class="hd-btn-text">使用说明</text>
    </view>
  </view>

  <!-- 概览卡 -->
  <view class="overview">
        <view class="ov-top">
          <view class="ov-main">
            <view class="ov-row">
              <text class="ov-num">{{attentionCount}}</text>
              <text class="ov-unit">件</text>
            </view>
            <text class="ov-label">件需要你留意</text>
          </view>

          <!-- 当前日期日历 -->
          <view class="ov-cal">
            <text class="cal-month">{{calMonth}}</text>
            <text class="cal-day">{{calDay}}</text>
            <text class="cal-week">{{calWeek}}</text>
          </view>
        </view>

    <view class="ov-grid">
      <view
        class="ov-cell"
        wx:for="{{stats}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onStatTap"
        hover-class="ov-cell-hover"
        hover-stay-time="60"
      >
        <text class="ov-cell-num" style="color:{{item.color}}">{{item.count}}</text>
        <text class="ov-cell-name">{{item.name}} ›</text>
      </view>
    </view>

    <view wx:if="{{total === 0}}" class="ov-zero">
      <text>还没有记录，点击下方 + 添加第一条</text>
    </view>
  </view>

  <!-- 温和提醒条 -->
  <view wx:if="{{urgentText}}" class="tip">
    <text class="tip-dot"></text>
    <text class="tip-text">{{urgentText}}</text>
  </view>

  <!-- 需要关注：临近 / 紧急（还没过期，提醒优先使用） -->
  <view class="sec">
    <view class="sec-hd">
      <text class="t-title">需要关注</text>
      <text
        wx:if="{{attention.length > 0}}"
        class="sec-more"
        data-status="attention"
        bindtap="goItems"
      >查看全部 ›</text>
    </view>

    <view wx:if="{{attention.length > 0}}" class="card-list">
      <item-card
        wx:for="{{attention}}"
        wx:key="id"
        item="{{item}}"
        compact="{{true}}"
        last-use="{{lastUse}}"
        bind:tap="goDetail"
        bind:use="onUse"
        bind:reset="onResetCard"
      />
    </view>
    <view wx:else class="card">
      <empty-state
        emoji="🌿"
        text="暂无需要关注"
        subText="没有临近或该处理的记录"
      />
    </view>
  </view>

  <!-- 需要处理：已过期 / 已超期 -->
  <view class="sec">
    <view class="sec-hd">
      <text class="t-title">需要处理</text>
      <text
        wx:if="{{todo.length > 0}}"
        class="sec-more"
        data-status="over"
        bindtap="goItems"
      >查看全部 ›</text>
    </view>

    <view wx:if="{{todo.length > 0}}" class="card-list">
      <item-card
        wx:for="{{todo}}"
        wx:key="id"
        item="{{item}}"
        compact="{{true}}"
        last-use="{{lastUse}}"
        bind:tap="goDetail"
        bind:use="onUse"
        bind:reset="onResetCard"
      />
    </view>
    <view wx:else class="card">
      <empty-state
        emoji="✨"
        text="没有待处理的"
        subText="没有已过期或超出期限的记录"
      />
    </view>
  </view>

  <!-- 悬浮添加 -->
  <view class="fab" bindtap="onAdd" hover-class="fab-hover" hover-stay-time="80">
    <text class="fab-plus">+</text>
  </view>

  <!-- 底部提示条（含撤销） -->
  <snackbar show="{{snackShow}}" text="{{snackText}}" bind:undo="onUndoUse" />

</view>
