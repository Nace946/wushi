<view class="page">

  <!-- 顶部问候 -->
  <view class="hd">
    <view class="hd-left">
      <text class="hd-hello">{{greeting}}</text>
      <text class="hd-date">{{dateText}}</text>
    </view>
    <view class="hd-btn" bindtap="goGuide">
      <text class="hd-btn-text">使用说明</text>
    </view>
  </view>

  <!-- 概览卡 -->
  <view class="overview">
    <view class="ov-row">
      <text class="ov-num">{{attentionCount}}</text>
      <text class="ov-unit">件</text>
    </view>
    <text class="ov-label">件物品需要你留意</text>

    <view class="ov-grid">
      <view
        class="ov-cell"
        wx:for="{{stats}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onStatTap"
        hover-class="ov-cell-hover"
        hover-stay-time="60"
      >
        <text class="ov-cell-num" style="color:{{item.color}}">{{item.count}}</text>
        <text class="ov-cell-name">{{item.name}} ›</text>
      </view>
    </view>

    <view wx:if="{{total === 0}}" class="ov-zero">
      <text>还没有物品，点击下方 + 添加第一件</text>
    </view>
  </view>

  <!-- 温和提醒条 -->
  <view wx:if="{{urgentText}}" class="tip">
    <text class="tip-dot"></text>
    <text class="tip-text">{{urgentText}}</text>
  </view>

  <!-- 需要关注：临近 / 紧急（还没过期，提醒优先使用） -->
  <view class="sec">
    <view class="sec-hd">
      <text class="t-title">需要关注</text>
      <text
        wx:if="{{attention.length > 0}}"
        class="sec-more"
        data-status="attention"
        bindtap="goItems"
      >查看全部 ›</text>
    </view>

    <view wx:if="{{attention.length > 0}}" class="card-list">
      <item-card
        wx:for="{{attention}}"
        wx:key="id"
        item="{{item}}"
        compact="{{true}}"
        bind:tap="goDetail"
      />
    </view>
    <view wx:else class="card">
      <empty-state
        emoji="🌿"
        text="暂无临近物品"
        subText="没有临近或紧急到期的物品"
      />
    </view>
  </view>

  <!-- 需要处理：已过期 / 已超期 -->
  <view class="sec">
    <view class="sec-hd">
      <text class="t-title">需要处理</text>
      <text
        wx:if="{{todo.length > 0}}"
        class="sec-more"
        data-status="over"
        bindtap="goItems"
      >查看全部 ›</text>
    </view>

    <view wx:if="{{todo.length > 0}}" class="card-list">
      <item-card
        wx:for="{{todo}}"
        wx:key="id"
        item="{{item}}"
        compact="{{true}}"
        bind:tap="goDetail"
      />
    </view>
    <view wx:else class="card">
      <empty-state
        emoji="✨"
        text="没有待处理物品"
        subText="没有已过期或超出使用期限的物品"
      />
    </view>
  </view>

  <!-- 悬浮添加 -->
  <view class="fab" bindtap="onAdd" hover-class="fab-hover" hover-stay-time="80">
    <text class="fab-plus">+</text>
  </view>

</view>
