<view class="page">

  <!-- 概览卡：问候 + 一句话文案 + 当前日期 + 物品/事件四档统计 -->
  <view class="overview">
    <view class="ov-top">
      <view class="ov-hello">
        <text class="ov-hello-text">{{greeting}}</text>
        <text class="ov-hello-slogan">{{slogan}}</text>
      </view>

      <!-- 当前日期日历 -->
      <view class="ov-cal">
        <text class="cal-month">{{calMonth}}</text>
        <text class="cal-day">{{calDay}}</text>
        <text class="cal-week">{{calWeek}}</text>
      </view>
    </view>

    <!-- 物品四档统计：组名在左，格子内数字在上、名称在下，点一下直达物品页对应筛选 -->
    <block wx:if="{{total > 0}}">
      <view class="ov-stat">
        <text class="ov-stat-tag">物品</text>
        <view class="ov-stat-cells">
          <view
            class="ov-cell"
            wx:for="{{stats}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onStatTap"
            hover-class="ov-cell-hover"
            hover-stay-time="60"
          >
            <text class="ov-cell-num" style="color:{{item.color}}">{{item.count}}</text>
            <text class="ov-cell-name">{{item.name}} ›</text>
          </view>
        </view>
      </view>

      <!-- 事件四档统计：最近 / 偏久 / 该做 / 快忘（依次对应事件列表的四档） -->
      <view class="ov-stat">
        <text class="ov-stat-tag">事件</text>
        <view class="ov-stat-cells">
          <view
            class="ov-cell"
            wx:for="{{eventStats}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onEventStatTap"
            hover-class="ov-cell-hover"
            hover-stay-time="60"
          >
            <text class="ov-cell-num" style="color:{{item.color}}">{{item.count}}</text>
            <text class="ov-cell-name">{{item.name}} ›</text>
          </view>
        </view>
      </view>
    </block>

    <view wx:else class="ov-zero">
      <text>还没有记录，点击下方 + 添加第一条</text>
    </view>
  </view>

  <!-- 置顶：手动钉在首页最上方的记录（最多 5 条，正计时/倒计时均可） -->
  <view wx:if="{{pinned.length > 0}}" class="sec">
    <view class="sec-hd">
      <view class="sec-title">
        <text class="sec-pin">📌</text>
        <text class="t-title">{{pinText.section}}</text>
      </view>
      <text class="sec-count" bindtap="onPinTip">{{pinned.length}}/{{pinLimit}}</text>
    </view>

    <view class="card-list pin-list">
      <item-card
        wx:for="{{pinned}}"
        wx:key="id"
        item="{{item}}"
        compact="{{true}}"
        last-use="{{lastUse}}"
        bind:tap="goDetail"
        bind:use="onUse"
        bind:reset="onResetCard"
      />
    </view>
  </view>

  <!-- 需要关注：临近 / 紧急（还没过期，提醒优先使用） -->
  <view wx:if="{{showAttention}}" class="sec">
    <view class="sec-hd">
      <text class="t-title">需要关注</text>
      <text
        wx:if="{{attention.length > 0}}"
        class="sec-more"
        data-status="attention"
        bindtap="goItems"
      >查看全部 ›</text>
    </view>

    <view wx:if="{{attention.length > 0}}" class="card-list">
      <item-card
        wx:for="{{attention}}"
        wx:key="id"
        item="{{item}}"
        compact="{{true}}"
        last-use="{{lastUse}}"
        bind:tap="goDetail"
        bind:use="onUse"
        bind:reset="onResetCard"
      />
    </view>
    <view wx:else class="card">
      <empty-state
        emoji="🌿"
        text="暂无需要关注"
        subText="没有临近或该处理的记录"
      />
    </view>
  </view>

  <!-- 需要处理：已过期 / 已超期 -->
  <view wx:if="{{showTodo}}" class="sec">
    <view class="sec-hd">
      <text class="t-title">需要处理</text>
      <text
        wx:if="{{todo.length > 0}}"
        class="sec-more"
        data-status="over"
        bindtap="goItems"
      >查看全部 ›</text>
    </view>

    <view wx:if="{{todo.length > 0}}" class="card-list">
      <item-card
        wx:for="{{todo}}"
        wx:key="id"
        item="{{item}}"
        compact="{{true}}"
        last-use="{{lastUse}}"
        bind:tap="goDetail"
        bind:use="onUse"
        bind:reset="onResetCard"
      />
    </view>
    <view wx:else class="card">
      <empty-state
        emoji="✨"
        text="没有待处理的"
        subText="没有已过期或超出期限的记录"
      />
    </view>
  </view>

  <!-- 悬浮添加 -->
  <view class="fab" bindtap="onAdd" hover-class="fab-hover" hover-stay-time="80">
    <text class="fab-plus">+</text>
  </view>

  <!-- 底部提示条（含撤销） -->
  <snackbar show="{{snackShow}}" text="{{snackText}}" bind:undo="onUndoUse" />

</view>
