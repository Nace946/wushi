/* ---------- 概览卡 ---------- */
.overview {
  background: linear-gradient(158deg, #e2ece6 0%, #ffffff 62%);
  border-radius: var(--r-lg);
  padding: 36rpx 32rpx 32rpx;
  box-shadow: var(--shadow);
}

.ov-top {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
}

/* 问候 + 一句话文案（已从页面顶部移进概览卡内）
   问候置于顶、文案沉到底，靠 space-between 把两者拉开，
   文案同时贴近下方统计行的横线 */
.ov-hello {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.ov-hello-text {
  display: block;
  font-size: 64rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.ov-hello-slogan {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-3);
  line-height: 1.5;
  max-width: 420rpx;
}

/* ---------- 日历 ---------- */
.ov-cal {
  width: 132rpx;
  margin-left: 20rpx;
  background: #ffffff;
  border-radius: var(--r-md);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  flex-shrink: 0;
}

.cal-month {
  display: block;
  background: var(--primary);
  color: #ffffff;
  font-size: 22rpx;
  text-align: center;
  padding: 6rpx 0;
}

.cal-day {
  display: block;
  text-align: center;
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--text);
  padding-top: 8rpx;
  font-variant-numeric: tabular-nums;
}

.cal-week {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-2);
  padding-bottom: 10rpx;
}

/* 物品 / 事件 四档统计：横线分隔，组名在左，格子「数字在上、名称在下」 */
.ov-stat {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(43, 47, 44, 0.06);
}

.ov-stat + .ov-stat {
  margin-top: 22rpx;
}

.ov-stat-tag {
  flex-shrink: 0;
  margin-right: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
  letter-spacing: 1rpx;
}

.ov-stat-cells {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.ov-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0;
  min-width: 0;
}

.ov-cell-num {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.ov-cell-name {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--text-3);
}

.ov-cell-hover {
  opacity: 0.55;
}

.ov-zero {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-3);
  text-align: center;
}

/* ---------- 区块 ---------- */
.sec {
  margin-top: 44rpx;
}

.sec-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 20rpx;
}

.sec-more {
  font-size: 26rpx;
  color: var(--text-3);
}

/* ---------- 置顶分组 ---------- */
.sec-title {
  display: flex;
  align-items: center;
}

.sec-pin {
  font-size: 28rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.sec-count {
  font-size: 24rpx;
  color: var(--text-3);
  background: var(--surface);
  border-radius: var(--r-pill);
  padding: 6rpx 18rpx;
  box-shadow: var(--shadow-sm);
}

.pin-list > item-card {
  display: block;
  margin-bottom: 20rpx;
}

.card-list > item-card {
  display: block;
  margin-bottom: 20rpx;
}

/* ---------- 分类 ---------- */
.cats {
  display: flex;
  flex-wrap: wrap;
}

.cat {
  width: 33.33%;
  padding: 0 8rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cat-icon {
  width: 100%;
  background: var(--surface);
  border-radius: var(--r-md);
  padding: 26rpx 0;
  box-shadow: var(--shadow-sm);
  text-align: center;
  font-size: 48rpx;
  line-height: 1;
}

.cat-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text);
}

.cat-count {
  font-size: 23rpx;
  color: var(--text-3);
}

.cat-hover .cat-icon {
  transform: scale(0.97);
  opacity: 0.9;
}

.fab-hover {
  opacity: 0.88;
  transform: scale(0.94);
}
