<view class="page">

  <!-- 头部 -->
  <view class="hero">
    <view class="hero-mark">
      <text class="hero-emoji">🌿</text>
      <text class="hero-name">物时</text>
    </view>
    <text class="hero-desc">记住物品的保质期，也记住每件事的间隔</text>
  </view>

  <!-- 统计 -->
  <view class="card stat-card">
    <view class="stat-row">
      <view class="stat">
        <text class="stat-num">{{total}}</text>
        <text class="stat-name">全部记录</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{itemCount}}</text>
        <text class="stat-name">物品</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{eventCount}}</text>
        <text class="stat-name">事件</text>
      </view>
    </view>
  </view>

  <!-- 偏好 -->
  <view class="block">
    <text class="block-title">偏好</text>
    <view class="card">
      <view class="cell" bindtap="onSort" hover-class="cell-hover" hover-stay-time="60">
        <text class="cell-label">列表默认排序</text>
        <text class="cell-value">{{sortName}} ›</text>
      </view>
      <view class="cell">
        <view>
          <text class="cell-label">首页显示「需要关注」</text>
          <text class="cell-hint">临近或即将到期的记录</text>
        </view>
        <switch checked="{{showAttention}}" bindchange="onAttentionChange" color="#3F8A6B" />
      </view>
      <view class="cell cell-last">
        <view>
          <text class="cell-label">首页显示「需要处理」</text>
          <text class="cell-hint">已过期或超出期限的记录</text>
        </view>
        <switch checked="{{showTodo}}" bindchange="onTodoChange" color="#3F8A6B" />
      </view>
    </view>
  </view>

  <!-- 其他 -->
  <view class="block">
    <text class="block-title">其他</text>
    <view class="card">
      <view class="cell" bindtap="goUsage" hover-class="cell-hover" hover-stay-time="60">
        <view>
          <text class="cell-label">使用记录</text>
          <text class="cell-hint">看看什么东西在什么时候用掉的</text>
        </view>
        <text class="cell-value">{{usageCount}} 条 ›</text>
      </view>
      <view class="cell" bindtap="goEventLog" hover-class="cell-hover" hover-stay-time="60">
        <view>
          <text class="cell-label">事件记录</text>
          <text class="cell-hint">看看每件事上次是什么时候做的</text>
        </view>
        <text class="cell-value">{{eventLogCount}} 条 ›</text>
      </view>
      <view class="cell" bindtap="goGuide" hover-class="cell-hover" hover-stay-time="60">
        <text class="cell-label">使用说明</text>
        <text class="cell-value">›</text>
      </view>
      <view class="cell cell-last" bindtap="onAdd" hover-class="cell-hover" hover-stay-time="60">
        <text class="cell-label">添加新记录</text>
        <text class="cell-value">›</text>
      </view>
    </view>
    <view class="card danger-card">
      <view class="cell cell-last" bindtap="onClear" hover-class="cell-hover" hover-stay-time="60">
        <text class="cell-label cell-danger">清空所有数据</text>
        <text class="cell-value">›</text>
      </view>
    </view>
  </view>

  <view class="foot">
    <text class="foot-line">物时 v{{version}}</text>
    <text class="foot-line">数据仅保存在本机，不会上传服务器</text>
    <text class="foot-line">更换手机或卸载小程序会导致数据丢失，请注意</text>
  </view>

</view>
