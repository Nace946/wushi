.main {
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 34rpx 32rpx 30rpx;
  box-shadow: var(--shadow);
}

.main-top {
  display: flex;
  align-items: center;
}

.main-emoji {
  font-size: 58rpx;
  line-height: 1;
  margin-right: 18rpx;
}

.main-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
}

.main-cat {
  margin-left: auto;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  background: var(--surface-soft);
  font-size: 24rpx;
  color: var(--text-2);
}

/* 主数值区：不画进度环，只放大时间 */
.plain-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 0 40rpx;
}

/* 状态文字（剩余 / 已过期 / 已过去）放在时间前面 */
.plain-label {
  font-size: 30rpx;
  color: var(--text-2);
  margin-bottom: 10rpx;
}

.plain-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

/* 主数值：单独天数与复合单位共用同一基准字号（76rpx），
   再按状态档位（mainSize 1~4）逐级放大 —— 越紧迫，数字越大 */
.plain-num {
  font-size: 76rpx;
  font-weight: 600;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.plain-num-s1 {
  font-size: 76rpx;
}

.plain-num-s2 {
  font-size: 92rpx;
}

.plain-num-s3 {
  font-size: 108rpx;
}

.plain-num-s4 {
  font-size: 124rpx;
}

.plain-unit {
  font-size: 40rpx;
  color: var(--text-2);
  margin-left: 6rpx;
  margin-right: 12rpx;
}

.state-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
}

.state-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.state-text {
  font-size: 27rpx;
  flex: 1;
}

/* ---------- 信息 ---------- */
/* ---------- 详细计时（年/月/日/时） ---------- */
.detail-time {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--r-md, 24rpx);
  background: var(--surface-soft, #fbfaf7);
  display: flex;
  align-items: baseline;
}

.dt-label {
  font-size: 24rpx;
  color: var(--text-3, #798178);
  margin-right: 14rpx;
  flex-shrink: 0;
}

.dt-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text, #1f2420);
  font-variant-numeric: tabular-nums;
}

.info {
  margin-top: 24rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: var(--text);
  text-align: right;
  max-width: 420rpx;
  word-break: break-all;
}

/* ---------- 操作 ---------- */
.ops {
  margin-top: 40rpx;
}

.op-btn {
  margin-bottom: 20rpx;
}

.foot-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}
