.main {
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 34rpx 32rpx 30rpx;
  box-shadow: var(--shadow);
}

.main-top {
  display: flex;
  align-items: center;
}

.main-emoji {
  font-size: 58rpx;
  line-height: 1;
  margin-right: 18rpx;
}

.main-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
}

.main-cat {
  margin-left: auto;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  background: var(--surface-soft);
  font-size: 24rpx;
  color: var(--text-2);
}

.ring-area {
  display: flex;
  justify-content: center;
  padding: 40rpx 0 30rpx;
}

.ring-num {
  font-size: 84rpx;
  font-weight: 600;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

/* 纯记录型事件：不画进度环，只放大天数 */
.plain-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 0 42rpx;
}

.plain-num {
  font-size: 132rpx;
  font-weight: 600;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.plain-unit {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--text-2);
}

.ring-unit {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.state-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
}

.state-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.state-text {
  font-size: 27rpx;
  flex: 1;
}

/* ---------- 信息 ---------- */
/* ---------- 详细计时（年/月/日/时） ---------- */
.detail-time {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--r-md, 24rpx);
  background: var(--surface-soft, #fbfaf7);
  display: flex;
  align-items: baseline;
}

.dt-label {
  font-size: 24rpx;
  color: var(--text-3, #798178);
  margin-right: 14rpx;
  flex-shrink: 0;
}

.dt-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text, #1f2420);
  font-variant-numeric: tabular-nums;
}

.info {
  margin-top: 24rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: var(--text);
  text-align: right;
  max-width: 420rpx;
  word-break: break-all;
}

/* ---------- 操作 ---------- */
.ops {
  margin-top: 40rpx;
}

.op-btn {
  margin-bottom: 20rpx;
}

.foot-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}
