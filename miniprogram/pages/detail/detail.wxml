<view class="page" wx:if="{{item}}">

  <!-- 主卡片 -->
  <view class="main">
    <view class="main-top">
      <text class="main-emoji">{{item.icon}}</text>
      <text class="main-name">{{item.name}}</text>
      <view class="main-cat">{{categoryName}}</view>
    </view>

    <!-- 主数值：不画进度环，把时间放大；状态文字在数字之前 -->
    <view class="plain-area">
      <text class="plain-label">{{state.mainLabel}}</text>
      <view class="plain-value">
        <block wx:for="{{state.mainParts}}" wx:key="index">
          <text class="plain-num plain-num-s{{state.mainSize}}" style="color:{{state.color}}">{{item.v}}</text>
          <text class="plain-unit">{{item.u}}</text>
        </block>
      </view>
    </view>

    <!-- 加入手机日历（v3.20）：紧跟在「剩余 N 天」下面，看完余量顺手就能设个到点提醒；
         直接落在到期当天 09:00，不扣提前提醒天数 -->
    <view
      wx:if="{{canCalendar}}"
      class="cal-entry"
      bindtap="onAddCalendar"
      hover-class="cal-entry-hover"
      hover-stay-time="60"
    >
      <text class="cal-ico">📅</text>
      <text class="cal-text">加入手机日历</text>
      <text class="cal-when">{{calendarHint}}</text>
    </view>

    <view class="state-bar" style="background:{{state.soft}};color:{{state.color}}">
      <text class="state-dot" style="background:{{state.color}}"></text>
      <text class="state-text">{{state.statusLabel}} · {{state.subText}}</text>
    </view>

    <!-- 正计时且开启详细计时：显示 年/月/日/时 细分 -->
    <view wx:if="{{detailText}}" class="detail-time">
      <text class="dt-label">{{detailLabel}}</text>
      <text class="dt-value">{{detailText}}</text>
    </view>
  </view>

  <!-- 信息 -->
  <view class="card info">
    <view class="info-row" wx:for="{{rows}}" wx:key="label">
      <text class="info-label">{{item.label}}</text>
      <text class="info-value">{{item.value}}</text>
    </view>
  </view>

  <!-- 操作 -->
  <view class="ops">
    <view wx:if="{{isCountUp}}" class="btn btn-primary op-btn" bindtap="onReset" hover-class="btn-hover" hover-stay-time="80">
      {{resetBtn}}
    </view>
    <!-- 倒计时事件：这件事已完成（循环则进入下一轮，不循环则记一次后收起） -->
    <view wx:elif="{{isEvent}}" class="btn btn-primary op-btn" bindtap="onFinishEvent" hover-class="btn-hover" hover-stay-time="80">
      这件事已完成
    </view>
    <!-- 倒计时物品：已用完 / 丢弃 -->
    <view wx:else class="btn btn-primary op-btn" bindtap="onFinish" hover-class="btn-hover" hover-stay-time="80">
      此物品已使用完或丢弃
    </view>
    <view wx:if="{{!isCountUp && !isEvent}}" class="btn btn-ghost op-btn" bindtap="onUse" hover-class="btn-hover" hover-stay-time="80">
      用掉一个 · 还剩 {{item.quantity}}{{item.unit}}
    </view>
    <view class="btn btn-ghost op-btn" bindtap="onEdit" hover-class="btn-hover" hover-stay-time="80">
      编辑信息
    </view>
    <view class="btn btn-danger-text op-btn" bindtap="onDelete" hover-class="btn-hover" hover-stay-time="80">
      {{isEvent ? '删除这条记录' : '删除这件物品'}}
    </view>
  </view>

  <view class="foot-tip">
    <text>数据保存在本机，卸载小程序或更换设备将丢失</text>
  </view>

</view>
