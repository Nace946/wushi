.es {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.es-icon {
  font-size: 88rpx;
  line-height: 1;
  opacity: 0.85;
  margin-bottom: 24rpx;
}

.es-text {
  font-size: 28rpx;
  color: var(--text-2, #6e7570);
}

.es-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-3, #a5aba6);
}

.es-btn {
  margin-top: 32rpx;
  padding: 18rpx 48rpx;
  border-radius: var(--r-pill, 999rpx);
  background: var(--primary, #5e8c7a);
  color: #ffffff;
  font-size: 28rpx;
}
