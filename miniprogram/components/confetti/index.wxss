.cf-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 400;
}

/* 丝带：极细的胶囊形长条，背景由 JS 生成（实色 → 半透明渐隐） */
.cf-piece {
  position: absolute;
  border-radius: 999rpx;
  opacity: 0;
  transform-origin: 50% 12%;
  animation-fill-mode: forwards;
}

.cf-l {
  animation-name: cfBurstL;
}

.cf-r {
  animation-name: cfBurstR;
}

/*
 * 左侧礼花：向右上方喷出 → 飘落向屏幕中间
 * 每段单独指定缓动：喷出快(减速)、滞空柔、落下加速、末段缓慢淡出
 */
@keyframes cfBurstL {
  0% {
    opacity: 0;
    transform: translate(0, 40rpx) rotate(0deg) scale(0.35);
    animation-timing-function: cubic-bezier(0.12, 0.85, 0.3, 1);
  }
  16% {
    opacity: 1;
    transform: translate(84rpx, -120rpx) rotate(110deg) scale(1);
    animation-timing-function: cubic-bezier(0.25, 0.5, 0.45, 1);
  }
  40% {
    opacity: 1;
    transform: translate(196rpx, -286rpx) rotate(250deg) scale(1);
    animation-timing-function: cubic-bezier(0.4, 0.05, 0.75, 0.6);
  }
  72% {
    opacity: 0.85;
    transform: translate(276rpx, -40rpx) rotate(430deg) scale(0.98);
    animation-timing-function: cubic-bezier(0.35, 0.2, 0.7, 0.9);
  }
  100% {
    opacity: 0;
    transform: translate(336rpx, 268rpx) rotate(620deg) scale(0.9);
  }
}

/* 右侧礼花：向左上方喷出 → 飘落向屏幕中间 */
@keyframes cfBurstR {
  0% {
    opacity: 0;
    transform: translate(0, 40rpx) rotate(0deg) scale(0.35);
    animation-timing-function: cubic-bezier(0.12, 0.85, 0.3, 1);
  }
  16% {
    opacity: 1;
    transform: translate(-84rpx, -120rpx) rotate(-110deg) scale(1);
    animation-timing-function: cubic-bezier(0.25, 0.5, 0.45, 1);
  }
  40% {
    opacity: 1;
    transform: translate(-196rpx, -286rpx) rotate(-250deg) scale(1);
    animation-timing-function: cubic-bezier(0.4, 0.05, 0.75, 0.6);
  }
  72% {
    opacity: 0.85;
    transform: translate(-276rpx, -40rpx) rotate(-430deg) scale(0.98);
    animation-timing-function: cubic-bezier(0.35, 0.2, 0.7, 0.9);
  }
  100% {
    opacity: 0;
    transform: translate(-336rpx, 268rpx) rotate(-620deg) scale(0.9);
  }
}
