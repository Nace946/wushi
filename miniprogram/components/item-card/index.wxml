<view class="ic" bindtap="onTap" bindlongpress="onLongPress" hover-class="ic-hover" hover-stay-time="80">
  <!-- 左侧图标 -->
  <view class="ic-icon" style="background:{{state.soft}}">
    <text class="ic-emoji">{{item.icon || '📦'}}</text>
  </view>

  <!-- 右侧主体 -->
  <view class="ic-body">
    <view class="ic-head">
      <text class="ic-name">{{item.name}}</text>
      <view class="ic-status" style="color:{{state.color}};background:{{state.soft}}">
        {{state.statusLabel}}
      </view>
    </view>

    <view class="ic-metric">
      <text class="ic-num" style="color:{{state.color}}">{{state.mainValue}}</text>
      <text class="ic-unit">{{state.mainUnit}}</text>
      <text class="ic-label">{{state.mainLabel}}</text>
      <text wx:if="{{meta}}" class="ic-meta">{{meta}}</text>
    </view>

    <!-- 正计时 + 详细计时：年/月/日/时 细分 -->
    <view wx:if="{{state.detailText}}" class="ic-detail">
      <text class="ic-detail-badge">{{state.detailText}}</text>
    </view>

    <!-- 进度条：纯记录型事件（无循环间隔）不显示 -->
    <view wx:if="{{!compact && state.hasProgress}}" class="ic-bar">
      <view class="ic-bar-fill" style="width:{{percentWidth}};background:{{state.color}}"></view>
    </view>

    <text wx:if="{{!compact}}" class="ic-sub">{{state.subText}}</text>
  </view>

  <!-- 快捷操作：倒计时 = 用掉一个；正计时 = 重新开始计时 -->
  <view wx:if="{{showUse}}" class="ic-use-wrap">
    <!-- 正计时：重置 -->
    <view
      wx:if="{{isCountUp}}"
      class="ic-use ic-use-reset {{popping ? 'ic-use-pop' : ''}}"
      catchtap="onReset"
      hover-class="ic-use-hover"
      hover-stay-time="60"
    >
      <text class="ic-use-minus">↺</text>
    </view>

    <!-- 倒计时：用掉一个 -->
    <block wx:else>
      <view
        class="ic-use {{popping ? 'ic-use-pop' : ''}} {{item.quantity <= 0 ? 'ic-use-off' : ''}}"
        catchtap="onUse"
        hover-class="ic-use-hover"
        hover-stay-time="60"
      >
        <text class="ic-use-minus">−</text>
      </view>
      <view wx:if="{{flying}}" class="ic-fly">−1</view>
    </block>
  </view>
</view>
