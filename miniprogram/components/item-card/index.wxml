<view class="ic" bindtap="onTap" bindlongpress="onLongPress" hover-class="ic-hover" hover-stay-time="80">
  <!-- 左侧图标 -->
  <view class="ic-icon" style="background:{{state.soft}}">
    <text class="ic-emoji">{{item.icon || '📦'}}</text>
  </view>

  <!-- 右侧主体 -->
  <view class="ic-body">
    <view class="ic-head">
      <text class="ic-name">{{item.name}}</text>
      <view class="ic-status" style="color:{{state.color}};background:{{state.soft}}">
        {{state.statusLabel}}
      </view>
    </view>

    <view class="ic-metric">
      <text class="ic-num" style="color:{{state.color}}">{{state.mainValue}}</text>
      <text class="ic-unit">{{state.mainUnit}}</text>
      <text class="ic-label">{{state.mainLabel}}</text>
      <text wx:if="{{meta}}" class="ic-meta">{{meta}}</text>
    </view>

    <view wx:if="{{!compact}}" class="ic-bar">
      <view class="ic-bar-fill" style="width:{{percentWidth}};background:{{state.color}}"></view>
    </view>

    <text wx:if="{{!compact}}" class="ic-sub">{{state.subText}}</text>
  </view>
</view>
