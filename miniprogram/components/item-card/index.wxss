.ic {
  display: flex;
  align-items: flex-start;
  background: #ffffff;
  border-radius: var(--r-lg, 32rpx);
  padding: 30rpx;
  box-shadow: var(--shadow, 0 6rpx 30rpx rgba(43, 47, 44, 0.08));
  transition: transform 0.18s ease;
}

.ic-hover {
  transform: scale(0.985);
}

.ic-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 22rpx;
}

.ic-emoji {
  font-size: 46rpx;
  line-height: 1;
}

.ic-body {
  flex: 1;
  min-width: 0;
}

.ic-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ic-name-wrap {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.ic-pin {
  font-size: 24rpx;
  line-height: 1;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.ic-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text, #1f2420);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 340rpx;
}

.ic-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill, 999rpx);
  flex-shrink: 0;
}

.ic-metric {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.ic-num {
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.ic-unit {
  font-size: 26rpx;
  color: var(--text-2, #535b55);
  margin-left: 4rpx;
}

.ic-label {
  font-size: 26rpx;
  color: var(--text-2, #535b55);
  margin-left: 10rpx;
}

.ic-meta {
  font-size: 24rpx;
  color: var(--text-3, #798178);
  margin-left: auto;
  flex-shrink: 0;
}

.ic-bar {
  margin-top: 16rpx;
  height: 12rpx; /* 加厚，提升进度可读性 */
  border-radius: var(--r-pill, 999rpx);
  background: #e8e6e0; /* 轨道比背景略深，条形容器的存在感更明确 */
  overflow: hidden;
}

.ic-bar-fill {
  height: 100%;
  border-radius: var(--r-pill, 999rpx);
  transition: width 0.4s ease;
}

.ic-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-3, #798178);
}

/* ---------- 用掉一个 ---------- */
.ic-use-wrap {
  position: relative;
  margin-left: 16rpx;
  flex-shrink: 0;
  align-self: center;
}

.ic-use {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary-soft, #dcefe4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ic-use-minus {
  font-size: 38rpx;
  line-height: 1;
  font-weight: 600;
  color: var(--primary, #3f8a6b);
}

.ic-use-hover {
  opacity: 0.72;
}

.ic-use-off {
  background: var(--surface-soft, #fbfaf7);
}

.ic-use-off .ic-use-minus {
  color: var(--text-3, #798178);
}

/* 按下回弹 */
@keyframes icPop {
  0% {
    transform: scale(1);
  }
  35% {
    transform: scale(0.82);
  }
  65% {
    transform: scale(1.14);
  }
  100% {
    transform: scale(1);
  }
}

.ic-use-pop {
  animation: icPop 0.32s ease;
}

/* −1 上浮消散 */
@keyframes icFly {
  0% {
    opacity: 1;
    transform: translateY(0) scale(0.9);
  }
  100% {
    opacity: 0;
    transform: translateY(-56rpx) scale(1.4);
  }
}

.ic-fly {
  position: absolute;
  left: 50%;
  bottom: 60rpx;
  margin-left: -30rpx;
  width: 60rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary, #3f8a6b);
  pointer-events: none;
  animation: icFly 0.8s ease-out forwards;
}

/* ---------- 详细计时徽标 ---------- */
.ic-detail {
  margin-top: 8rpx;
}

.ic-detail-badge {
  display: inline-block;
  font-size: 22rpx;
  color: var(--text-2, #535b55);
  background: var(--surface-soft, #fbfaf7);
  padding: 4rpx 14rpx;
  border-radius: var(--r-sm, 16rpx);
  font-variant-numeric: tabular-nums;
}
